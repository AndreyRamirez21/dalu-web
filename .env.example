# Supabase (requeridas para consultar el catálogo)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL pública usada al generar el sitemap
SITE_URL=https://your-domain.com

# Instagram: solo para la función serverless de Vercel. Nunca uses el prefijo VITE_.
INSTAGRAM_ACCOUNT_ID=your-professional-instagram-account-id
INSTAGRAM_ACCESS_TOKEN=your-server-only-access-token
